# Copy to ~/.config/evidence-archive/environment and replace every placeholder.
# EnvironmentFile does not expand ~, $HOME, or systemd's %h specifier.
EVIDENCE_ROOT=/absolute/path/to/evidence-collection
EVIDENCE_REPO=/absolute/path/to/evidence-collection/repo
EVIDENCE_ARCHIVE=/absolute/path/to/evidence-collection/archive
EVIDENCE_BACKUP_DEST=
BACKUP_STAGE_DIR=/absolute/path/to/evidence-collection/backup-stage
EVIDENCE_CONTROL_URL=
EVIDENCE_CONTROL_CHECK="Evidence control target"
EVIDENCE_READINESS_HOST=replace-with-reviewed-host.example
EVIDENCE_COLLECTOR_INSTANCE_ID=replace-with-stable-unique-host-id
EVIDENCE_CONTROL_MAX_PUBLISHER_AGE_SECONDS=14400
EVIDENCE_CONTROL_MAX_POLL_AGE_SECONDS=7200
EVIDENCE_ALERT_URL=
EVIDENCE_HEALTH_STATE=/absolute/path/to/evidence-collection/health-last.txt
EVIDENCE_ALERT_STAMP=/absolute/path/to/evidence-collection/health-alert.stamp
EVIDENCE_ALERT_MIN_INTERVAL_SECONDS=21600
EVIDENCE_HEARTBEAT_URL=https://api.github.com/repos/OWNER/evidence-control/dispatches
EVIDENCE_HEARTBEAT_TOKEN_FILE=/absolute/path/to/heartbeat-token
RCLONE=/absolute/path/to/rclone
