[Unit]
Description=Evidence archive — upgrade pending timestamp proofs to Bitcoin attestation
Documentation=https://github.com/petesherratt-collab/evidence-archive
# An OpenTimestamps proof arrives as a calendar attestation and only gains its
# Bitcoin attestation once a block commits to it, hours later. Until upgraded, a
# proof rests on the calendar operators staying honest and available — a weaker
# claim than the one the archive wants to make, and one that quietly expires if
# a calendar disappears. This is what closes that gap.
#
# StartLimit* is only read in [Unit]; under [Service] it is silently ignored.
# The value here matches the default it was accidentally deferring to, so the
# behaviour does not change — it is now declared where it is read.
StartLimitBurst=5

[Service]
Type=oneshot
WorkingDirectory=/home/peters/evidence-collection
ExecStartPre=/home/peters/evidence-collection/repo/deploy/wait-for-resolvable.sh a.pool.opentimestamps.org 120
ExecStart=/home/peters/evidence-collection/.venv/bin/kibitzr archive anchor-upgrade
Environment=KIBITZR_ARCHIVE_OTS=/home/peters/evidence-collection/.venv-anchor/bin/ots

# Retry rather than waiting for the next hourly slot. Upgrading is idempotent,
# so a retry that turns out to be premature is a no-op.
Restart=on-failure
RestartSec=5min

Nice=10
IOSchedulingClass=idle
