[Unit]
Description=Evidence archive — commit chain heads to an external timestamp
Documentation=https://github.com/petesherratt-collab/evidence-archive
# Anchoring is the step that turns a self-consistent database into evidence.
# Unlike a missed poll, unattested time cannot be recovered later: nothing can
# retroactively prove that today's heads existed today. So this runs daily from
# the start rather than waiting for the schema to settle — proofs accumulate,
# and an anchor taken under an older format stays valid forever.
#
# StartLimit* is only read in [Unit]; under [Service] it is silently ignored.
# The value here matches the default it was accidentally deferring to, so the
# behaviour does not change — it is now declared where it is read.
StartLimitBurst=5

[Service]
Type=oneshot
EnvironmentFile=%h/.config/evidence-archive/environment
ExecStartPre=/usr/bin/env bash -c 'exec "$EVIDENCE_REPO/deploy/wait-for-resolvable.sh" a.pool.opentimestamps.org 120'
ExecStart=/usr/bin/env bash -c 'exec "$EVIDENCE_ROOT/.venv/bin/kibitzr" archive anchor --root "$EVIDENCE_ARCHIVE" --ots "$EVIDENCE_ROOT/.venv-anchor/bin/ots"'

# Retry a failed run rather than waiting a day for the next one. Anchoring is
# the step whose loss is unrecoverable — nothing can retroactively prove that
# today's heads existed today — and the failures seen so far are transient
# network ones that a second attempt clears. Restart=on-failure is permitted
# for Type=oneshot; on-success is not, which is what we want either way.
Restart=on-failure
RestartSec=5min

# Anchoring must never be able to disturb collection. It runs in its own
# process against its own virtualenv, and a failure here leaves the archive
# exactly as it was — a failed anchor is recorded as failed, not skipped.
Nice=10
IOSchedulingClass=idle
