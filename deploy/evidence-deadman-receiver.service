[Unit]
Description=Off-host evidence dead-man event receiver
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/evidence-deadman/environment
ExecStart=/usr/bin/python3 /opt/evidence-collection/repo/deploy/deadman-receiver.py serve
Restart=on-failure
DynamicUser=true
StateDirectory=evidence-deadman

[Install]
WantedBy=multi-user.target
