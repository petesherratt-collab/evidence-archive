[Unit]
Description=Evidence archive — UK government contract awards collection
Documentation=https://github.com/petesherratt-collab/evidence-archive
# NOTE: this unit deliberately does NOT carry `After=network-online.target`.
# It used to, with a comment claiming it prevented boot-time DNS failures being
# recorded as failed polls. That was never true: network-online.target exists in
# the *system* systemd manager, not in the per-user manager this service runs
# under, where it resolves to not-found and the ordering is silently ignored.
# On 2 Aug 2026 the service started ahead of the network and wrote 25 failed
# polls into the archive, each blaming the wrong cause.
#
# A user unit cannot order against a system target, so the wait is explicit
# below. It is bounded: an unreachable target should be recorded as unreachable,
# not silently not polled.
#
# The archive is the point of the process; never let a restart loop truncate it.
# StartLimit* belongs in [Unit] and is parsed nowhere else. It sat under
# [Service] until 4 Aug 2026, where systemd logged `Unknown key ... ignoring`
# once per start and applied the 10s/5 default instead — so the guarantee the
# comment asserted was not in effect, the same way `After=network-online.target`
# was not. RestartSec=60 kept five starts from ever landing inside ten seconds,
# so nothing had gone wrong yet; it would have the moment that changed.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/peters/evidence-collection
ExecStartPre=/home/peters/evidence-collection/repo/deploy/wait-for-resolvable.sh
ExecStart=/home/peters/evidence-collection/.venv/bin/kibitzr run
# kibitzr keeps its own schedule from each check's `period`, so this is a
# long-lived process rather than a timer. A timer firing `once` would ignore
# the per-check periods and poll every target at the same rate.
Restart=always
RestartSec=60

# Collection is I/O-bound and should yield to anything interactive.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
